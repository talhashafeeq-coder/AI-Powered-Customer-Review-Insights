# AI-Powered Customer Review Insights - Environment Configuration
# Copy this file to .env and update the values with your actual credentials

# ==============================================
# MONGODB CONFIGURATION
# ==============================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secure_password_123
MONGO_INITDB_DATABASE=review_insights
DATABASE_NAME=review_insights

# ==============================================
# AI SERVICE CONFIGURATION (GROQ)
# ==============================================
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Available models:
# - llama-3.1-8b-instant (fastest, recommended)
# - llama-3.1-70b-versatile (most capable)
# - mixtral-8x7b-32768 (balanced)

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
DEBUG=False
ALLOWED_ORIGINS=["*"]
MAX_REQUESTS_PER_MINUTE=60

# ==============================================
# MONGO EXPRESS (Database Admin UI)
# ==============================================
# Optional: Customize MongoDB Express login credentials
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123

# ==============================================
# DOCKER COMPOSE NOTES
# ==============================================
# The application will be available at:
# - Frontend: http://localhost:8080
# - Backend API: http://localhost:8001
# - MongoDB Express: http://localhost:8081
# - MongoDB: localhost:27017